{
  "manifest_version": 3,
  "name": "Rewind — find it in the lecture",
  "short_name": "Rewind",
  "version": "0.1.0",
  "description": "Find the moment a lecture explained an idea. Local, bilingual (English/中文) search over the captions of your own Panopto recordings.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open Rewind" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting"],
  "optional_host_permissions": ["https://*.panopto.com/*", "https://*.panopto.eu/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
